{
  "name": "playwright-test-automation-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Sample Playwright + TypeScript test suite: UI and API tests with CI on every pull request.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
